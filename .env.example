# AeroShield local configuration
# Copy to .env and fill in only what you need. Do not commit .env.

# development | production
# production refuses to boot on the old published API key.
AEROSHIELD_ENV=development

# Private key for dispatch, retrain, and the voice posts.
# Leave this empty to keep those routes closed.
# Do not use aeroshield-dev-key. That string is in the git history and the API rejects it.
AEROSHIELD_API_KEY=

# Leave this empty to verify the sample ledgers already in outputs/.
# Those files were sealed with a demo key that is published in the source.
# Set a new value only if you create a fresh ledger. A new value will not match the sample files.
AEROSHIELD_HMAC_KEY=

# Optional language-model add-on. Off by default.
# The case-study triage agent is the rule matrix, not this copilot.
VOICE_ENABLED=false
SARVAM_API_KEY=
