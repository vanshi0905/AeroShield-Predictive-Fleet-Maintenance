{
  "version": 2,
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "outputs/**/*.{json,csv,db,yaml,yml}",
      "excludeFiles": "{data/**,outputs/**/*.parquet,outputs/**/*.joblib,outputs/mlflow.db,docs/**,layer_documentation/**,shield/tests/**,**/*.md,**/*.zip}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?_route=$1"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    }
  ]
}
