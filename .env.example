# AeroShield Environment Variables & Security Configuration

# Deployment Environment: development | production
AEROSHIELD_ENV=development

# Administrative API Key for Protected Write Endpoints (/api/work-orders/dispatch, /api/retrain/trigger)
# In development, defaults to 'aeroshield-dev-key'.
# In production, AEROSHIELD_API_KEY must be set to a cryptographically secure random secret.
AEROSHIELD_API_KEY=aeroshield-dev-key

# Keyed HMAC-SHA256 Secret for Immutable Cryptographic Audit Log (Layer 5)
# In development, defaults to 'aeroshield-v3-secret-key'.
# In production, AEROSHIELD_HMAC_KEY must be set to a private secret key.
AEROSHIELD_HMAC_KEY=aeroshield-v3-secret-key

# Optional: Sarvam AI Voice Copilot & Bulbul Neural Speech Synthesis
# AeroShield operates 100% autonomously without external keys.
# To optionally enable the multilingual avionics voice cockpit, set:
VOICE_ENABLED=false
SARVAM_API_KEY=
