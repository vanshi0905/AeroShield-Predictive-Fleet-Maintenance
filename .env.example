# AeroShield local configuration
# Copy to .env and fill in only what you need. Do not commit .env.

# development | production
AEROSHIELD_ENV=development

# Private key for dispatch and retrain endpoints.
# Leave this empty to keep those routes closed.
# aeroshield-dev-key is public (it is in the repo) and is never accepted here.
AEROSHIELD_API_KEY=

# One-click demos on a trusted local machine only: set to true and the published demo key is accepted
# (the dashboard uses it automatically). Leave empty or false everywhere else.
AEROSHIELD_DEMO_MODE=

# Leave this empty to verify the sample ledgers already in outputs/.
# Those files were sealed with a demo key that is published in the source.
# Set a new value only if you create a fresh ledger. A new value will not match the sample files.
AEROSHIELD_HMAC_KEY=
